# Porta do servidor
PORT=3000

# Caminho do banco SQLite
DB_ARQUIVO=./dados/academia.db

# Chave que assina as sessoes.
# Pode deixar em branco: o sistema sorteia uma na primeira execucao e guarda
# em dados/chave-de-sessao. Defina aqui so se voce quiser controlar a chave.
# APP_SEGREDO=

# Primeiro usuario dono, criado na primeira execucao.
# Sem DONO_SENHA, o sistema sorteia uma senha forte e mostra UMA vez no terminal.
DONO_EMAIL=dono@atak.com
DONO_NOME=Dono da Atak
# DONO_SENHA=

# Ponha 1 quando o sistema roda atras de nginx, Caddy ou outro proxy,
# para o freio de tentativas de login enxergar quem esta tentando.
ATRAS_DE_PROXY=0

# Onde o "npm run backup" grava as copias
BACKUP_PASTA=./dados/backups
